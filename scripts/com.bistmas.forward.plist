<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job: run the monthly forward decision on calendar days 1-5 at 08:30 and at load (catch-up).
     Install: cp scripts/com.bistmas.forward.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.bistmas.forward.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bistmas.forward</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>bistmas</string><string>forward</string><string>--catchup</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>BISTMAS_CONFIG</key><string>configs/forward.toml</string></dict>
  <key>WorkingDirectory</key><string>/Users/vedat/Finans_Tübitak</string>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Day</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/vedat/Finans_Tübitak/data/runs/forward/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/vedat/Finans_Tübitak/data/runs/forward/launchd.err</string>
</dict>
</plist>
